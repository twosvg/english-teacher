    <!-- 主界面 -->
    <string name="main_headline">选中就讲，不离开原 App</string>
    <string name="main_subtitle">在 X、Instagram 里选中文字复制，点悬浮球就能解析；Chrome 等支持系统菜单的 App 可以直接从菜单点 Surflect。</string>
