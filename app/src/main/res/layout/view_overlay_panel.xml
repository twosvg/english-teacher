<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay_panel"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayReadClipboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:text="@string/overlay_read_clipboard"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/overlayClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:text="@string/close_symbol"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/overlaySource"
            style="@style/InputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="14dp"
            android:hint="@string/overlay_source_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:minLines="1" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipWord"
                    style="@style/CardTab"
                    android:text="@string/tab_word" />

                <TextView
                    android:id="@+id/chipSentence"
                    style="@style/CardTab"
                    android:text="@string/tab_sentence" />

                <TextView
                    android:id="@+id/chipTranslate"
                    style="@style/CardTab"
                    android:text="@string/btn_translate" />

                <TextView
                    android:id="@+id/chipPolish"
                    style="@style/CardTab"
                    android:text="@string/tab_check" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/overlayScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbarStyle="insideOverlay">

            <TextView
                android:id="@+id/overlayResult"
                style="@style/ResultText"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/overlayFollowUp"
                style="@style/InputEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/overlay_follow_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="2" />

            <Button
                android:id="@+id/overlaySend"
                style="@style/FlatButton"
                android:layout_marginStart="4dp"
                android:text="@string/overlay_send" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlayFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/overlayRegenerate"
                style="@style/FlatButton"
                android:text="@string/action_regenerate" />

            <Button
                android:id="@+id/overlayCopy"
                style="@style/FlatButton"
                android:text="@string/action_copy" />

            <Button
                android:id="@+id/overlaySave"
                style="@style/FlatButton"
                android:text="@string/overlay_save" />

            <Button
                android:id="@+id/overlayCloseBottom"
                style="@style/FlatButton"
                android:text="@string/action_close" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
